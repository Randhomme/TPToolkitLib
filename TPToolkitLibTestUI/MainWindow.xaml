<Window x:Class="TPToolkitLibUITest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPToolkitLibUITest"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="5">
            <Button Margin="5" Content="X MDB to 1 OBJ/GLB" Click="Button_Click"/>
            <Button Margin="5" Content="X MDB to X OBJ" Click="Button_Click_1"/>
            <Button Margin="5" Content="X MDB to X GLB" Click="Button_Click_2"/>
        </StackPanel>
    </Grid>
</Window>
